    <style>
      /* Quick inline styles to fix your layout layout */
      .amazon-body-container {
        margin-top: 80px;
        padding: 0px;
        width: 100%; /* Changed from 220px to full width so items can fit side-by-side */
        box-sizing: border-box;
      }
      .product-info {
        height: 50px;
      }

      /* This container now holds ALL products and forces them into rows */
      /* Container holds ALL products and scales responsively */
      .product-grid {
        display: grid;
        /* Default for smaller/resized screens: fill rows based on available space */
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 12px; /* Slightly increased gap for better breathing room between cards */
      }

      /* Desktop override: Forces exactly 5 columns when the screen is wide enough */
      @media (min-width: 1100px) {
        .product-grid {
          grid-template-columns: repeat(6, 1fr);
        }
      }

      /* Standardizing the product card look */
      .product-card {
        background-color: white;
        border: 1px solid #e0e0e0;
        padding: 15px;
        border-radius: 4px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }

      .product-image-wrapper img {
        max-width: 100%;
        height: auto;
        display: block;
        margin: 0 auto;
      }
    </style>
  </head>
